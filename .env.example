# SQLite database used by Prisma (path is resolved relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs (src/lib/session.ts). Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Groq API key, only needed to run the local Tier-2 security judge (judge.py).
# Not used by the Next.js app itself. Get one at https://console.groq.com/
GROQ_API_KEY=
